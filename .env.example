# 複製這個檔案成 .env.local，再填入你自己的值。
# .env.local 不會被推上 GitHub。

# 網站正式網址（部署後改成你的網域，結尾不要加 /）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase：Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# anon key 或 publishable key 都可以
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 放音樂、圖片、影片的 Storage bucket 名稱（schema.sql 會建立 media，通常不用改）
SUPABASE_MEDIA_BUCKET=media
